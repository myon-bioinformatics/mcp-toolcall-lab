# LibreChat .env for docker/librechat-smoke only. Dummy secrets; not for prod.
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
SEARCH=false
MEILI_NO_ANALYTICS=true
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ENDPOINTS=custom
DEBUG_LOGGING=true
CONSOLE_JSON=false
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
# 32-byte hex / 16-byte hex — fixed so the smoke is deterministic.
CREDS_KEY=f34be427ebb29de8d88c107a71546019685ed8b9f4d3b1c7959d4739ca97a4ab
CREDS_IV=e234141c7234bd2b5c5203d33773fdd7
JWT_SECRET=mcp-toolcall-lab-librechat-smoke-jwt-secret-key
JWT_REFRESH_SECRET=mcp-toolcall-lab-librechat-smoke-jwt-refresh
# Avoid pulling optional RAG / Meili by leaving their URLs unset.
