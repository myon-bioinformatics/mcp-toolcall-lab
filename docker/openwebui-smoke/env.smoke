# Open WebUI env for docker/openwebui-smoke only. Dummy secrets; not for prod.
# WEBUI_AUTH=False only works on a fresh data dir (this smoke uses an anonymous volume).
WEBUI_AUTH=False
WEBUI_SECRET_KEY=mcp-toolcall-lab-openwebui-smoke-secret
WEBUI_NAME=mcp-toolcall-lab Open WebUI smoke
ENABLE_PERSISTENT_CONFIG=False
ENABLE_OLLAMA_API=False
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=http://openai-mock:8090/v1
OPENAI_API_KEY=sk-mcp-toolcall-lab
DEFAULT_MODELS=lab-model
DEFAULT_MODEL_PARAMS={"function_calling":"native"}
DEFAULT_MODEL_METADATA={"toolIds":["server:mcp:lab"]}
ENABLE_DIRECT_CONNECTIONS=True
ENABLE_FORWARD_USER_INFO_HEADERS=True
ENABLE_WEB_SEARCH=False
ENABLE_IMAGE_GENERATION=False
ENABLE_CODE_INTERPRETER=False
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False
MCP_INITIALIZE_TIMEOUT=30
AIOHTTP_CLIENT_TIMEOUT_TOOL_SERVER=60
# Dummy OpenAI-compatible key for the in-network mock only. Not a live provider credential.
TOOL_SERVER_CONNECTIONS=[{"type":"mcp","url":"http://mcp-mock:8000/mcp","path":"","auth_type":"none","key":"","config":{"enable":true},"headers":{"X-OpenWebUI-Chat-Id":"{{CHAT_ID}}","X-OpenWebUI-Message-Id":"{{MESSAGE_ID}}"},"info":{"id":"lab","name":"mcp-toolcall-lab","description":"lab Streamable HTTP MCP mock"}}]
