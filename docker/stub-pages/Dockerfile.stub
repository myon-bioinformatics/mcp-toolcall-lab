# Stdlib stub chat UI + vendored markdown.py. Do not install the MCP SDK here.
FROM python:3.12-slim
WORKDIR /app
COPY vendor/markdown.py /app/vendor/markdown.py
COPY src /app/src
COPY fixtures/stub_front /app/fixtures/stub_front
ENV PYTHONPATH=/app/src
ENV STUB_HOST=0.0.0.0
ENV STUB_PORT=8765
EXPOSE 8765
CMD ["python", "-m", "mcp_toolcall_lab.stub_front", "serve"]
