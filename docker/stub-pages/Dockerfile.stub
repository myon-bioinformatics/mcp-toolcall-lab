# Stdlib stub chat UI + vendored markdown.py. Do not install the MCP SDK here.
FROM python:3.15.1-slim-trixie@sha256:08275f764e022331c6d3e3ca55d8cce01fa4684b02111adf0445d71806fe7941
# Ordinary signed Debian security update; no custom CA trust overrides.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates=20250419+deb13u1 \
    && rm -rf /var/lib/apt/lists/*
# Hash-pinned bootstrap from the Python security advisory (see docs/software-components.md).
RUN python -m pip install --no-cache-dir --no-deps \
    "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
WORKDIR /app
COPY vendor/markdown.py /app/vendor/markdown.py
COPY src /app/src
COPY fixtures/stub_front /app/fixtures/stub_front
ENV PYTHONPATH=/app/src
ENV STUB_HOST=0.0.0.0
ENV STUB_PORT=8765
EXPOSE 8765
CMD ["python", "-m", "mcp_toolcall_lab.stub_front", "serve"]
